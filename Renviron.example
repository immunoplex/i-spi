# .Renviron.example  --  copy to .Renviron (gitignored) and fill in real values.
# R reads .Renviron automatically at startup; the app pulls everything via
# Sys.getenv(). NEVER commit the real .Renviron -- secrets stay out of git.

# ---- i-spi-compute API (replaces the retired BATCH_API_URL / BATCH_API_KEY) --
# Base URL includes the /i-spi-compute root path; do NOT append /jobs.
ISPI_COMPUTE_URL=https://madi-preprod.dartmouth.edu/i-spi-compute
# From the sealed secret `i-spi-compute`, key API_KEY. Placeholder here:
ISPI_COMPUTE_API_KEY=REPLACE_ME
#
# Additional compute clones: add a parallel pair per clone, naming it
# ISPI_COMPUTE_URL__<LABEL> / ISPI_COMPUTE_API_KEY__<LABEL> with the SAME
# <LABEL> suffix on both. A project/study is routed to it by setting its
# `compute_cluster` setting (via the Settings tab) to that label
# (case-insensitive, "-"/"_" interchangeable). New clones require an app pod
# restart to be picked up.
#
# "sim" clone (dev/i-spi-compute-sim.k8s.yaml) -- a second, real preprod
# stack. It deliberately reuses the i-spi-compute SealedSecret's API_KEY
# (see that manifest's header), so its key is the SAME value as
# ISPI_COMPUTE_API_KEY above, not a different secret. Set compute_cluster =
# "sim" on a study to route it here.
ISPI_COMPUTE_URL__SIM=https://madi-preprod.dartmouth.edu/i-spi-compute-sim
ISPI_COMPUTE_API_KEY__SIM=REPLACE_ME

# ---- Database (unchanged) ----------------------------------------------------
db=REPLACE_ME
db_host=REPLACE_ME
db_port=5432
db_userid_x=REPLACE_ME
db_pwd_x=REPLACE_ME
# Optional: 'require' to force TLS for the read-only DB diagnostic connection.
db_sslmode=

# ---- Dev toggles -------------------------------------------------------------
# LOCAL_DEV=1 disables Dex OIDC auth for local runs.
LOCAL_DEV=0
